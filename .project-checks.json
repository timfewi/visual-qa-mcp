{
  "version": 1,
  "checks": [
    {
      "name": "nix-format",
      "argv": ["nix", "fmt", "--no-write-lock-file", "--", "--ci"],
      "requires": ["nix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "statix",
      "argv": ["statix", "check", "."],
      "requires": ["statix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "deadnix",
      "argv": ["deadnix", "--fail", "."],
      "requires": ["deadnix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "bun-check",
      "argv": ["bun", "run", "check"],
      "requires": ["bun"],
      "timeout_seconds": 600,
      "profiles": ["fast"]
    },
    {
      "name": "build",
      "argv": ["bun", "run", "build"],
      "requires": ["bun"],
      "timeout_seconds": 300,
      "profiles": ["fast"]
    },
    {
      "name": "flake-check",
      "argv": ["nix", "flake", "check"],
      "requires": ["nix"],
      "timeout_seconds": 1800,
      "profiles": ["full"]
    }
  ],
  "watch_ignore": [
    ".direnv",
    ".visual-qa",
    "coverage",
    "dist",
    "node_modules",
    "playwright-report",
    "result",
    "result-*",
    "test-results"
  ]
}
