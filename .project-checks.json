{
  "version": 2,
  "checks": [
    {
      "name": "nix-format",
      "argv": ["just", "nix-format"],
      "requires": ["just", "nix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "flake-eval",
      "argv": ["just", "flake-eval"],
      "requires": ["just", "nix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "source-filter",
      "argv": ["just", "source-filter"],
      "requires": ["just", "python3", "nix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "statix",
      "argv": ["just", "statix"],
      "requires": ["just", "statix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "deadnix",
      "argv": ["just", "deadnix"],
      "requires": ["just", "deadnix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "bun-check",
      "argv": ["just", "check"],
      "requires": ["just", "bun"],
      "timeout_seconds": 600,
      "profiles": ["fast"]
    },
    {
      "name": "build",
      "argv": ["just", "build"],
      "requires": ["just", "bun"],
      "timeout_seconds": 300,
      "profiles": ["fast"]
    },
    {
      "name": "flake-check",
      "argv": ["just", "verify"],
      "requires": ["just", "nix"],
      "timeout_seconds": 1800,
      "profiles": ["full"],
      "expected_warnings": [
        {
          "message": "warning: The check omitted these incompatible systems: aarch64-linux",
          "reason": "The full gate builds on x86_64-linux. The fast gate evaluates both Linux outputs.",
          "max_count": 1
        },
        {
          "message": "warning: The check omitted these incompatible systems: x86_64-linux",
          "reason": "The full gate builds on aarch64-linux. The fast gate evaluates both Linux outputs.",
          "max_count": 1
        }
      ]
    }
  ],
  "watch_ignore": [
    ".devenv",
    ".direnv",
    ".tabula/state.json",
    ".tabula/index.html",
    ".visual-qa",
    "coverage",
    "dist",
    "node_modules",
    "playwright-report",
    "result",
    "result-*",
    "test-results"
  ]
}
