{
  "name": "visual-qa-mcp",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "An MCP server for evidence-backed visual QA of web interfaces.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "visual-qa-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "bun test --parallel=3 --parallel-delay=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "axe-core": "4.13.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.61.1",
    "pngjs": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "7.0.2"
  }
}
